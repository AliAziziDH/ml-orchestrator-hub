[Unit]
Description=Orchestra FastAPI Gateway Service
After=network.target

[Service]
User=orchestra
Group=orchestra
WorkingDirectory=/opt/ml-orchestrator-hub
Environment="PATH=/opt/ml-orchestrator-hub/venv/bin"
Environment="ALLOWED_IPS_JSON=[\"173.245.48.0/20\", \"103.21.244.0/22\", \"103.22.200.0/22\", \"103.31.4.0/22\", \"141.101.64.0/18\", \"108.162.192.0/18\", \"190.93.240.0/20\", \"188.114.96.0/20\", \"197.234.240.0/22\", \"198.41.128.0/17\", \"162.158.0.0/15\", \"104.16.0.0/13\", \"104.24.0.0/14\", \"172.64.0.0/13\", \"131.0.72.0/22\", \"167.89.0.0/17\", \"208.117.48.0/20\", \"50.31.32.0/19\", \"198.37.144.0/20\", \"198.21.0.0/21\", \"192.254.112.0/20\", \"168.245.0.0/17\", \"149.72.0.0/16\", \"159.183.0.0/16\"]"
# Set your HMAC secret for webhook security
# Environment="ORCHESTRA_HMAC_SECRET=your_super_secret_hmac_key_here"
# Environment="CONDUCTOR_AUTHORIZED_EMAIL=conductor@yourdomain.com"

# Start the uvicorn server running the FastAPI app
ExecStart=/opt/ml-orchestrator-hub/venv/bin/uvicorn orchestrator_core.gateway:app --host 127.0.0.1 --port 8000 --workers 4

Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
